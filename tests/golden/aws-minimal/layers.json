{
  "ai-integrations": {
    "vars": {
      "account_id": "123456789012",
      "bastion": {
        "access": "ssm",
        "public_ip": false
      },
      "certificates": {
        "cloudfront": false,
        "key_algorithm": "RSA_2048"
      },
      "container_registry": {
        "image_tag_mutability": "IMMUTABLE",
        "scan_on_push": true
      },
      "features": {
        "bastion": false,
        "certificates": false,
        "container_registry": false,
        "karpenter": false,
        "kms": false,
        "kubernetes_cluster": false,
        "network": true,
        "object_storage": false,
        "postgresql": false,
        "public_dns": false,
        "redis": false
      },
      "kms": {
        "deletion_window_days": 30
      },
      "kubernetes_cluster": {
        "node_groups": {
          "initial": {
            "ami_type": "AL2023_x86_64_STANDARD",
            "capacity_type": "ON_DEMAND",
            "desired_size": 2,
            "disk": {
              "encrypted": true,
              "size_gb": 100,
              "type": "gp3"
            },
            "instance_types": [
              "m6a.large"
            ],
            "max_size": 3,
            "max_unavailable": 1,
            "metadata": {
              "hop_limit": 2,
              "http_tokens": "optional"
            },
            "min_size": 1,
            "subnet_tier": "node"
          }
        },
        "node_role_policies": [
          "AmazonEKSWorkerNodePolicy",
          "AmazonEKS_CNI_Policy",
          "AmazonEC2ContainerRegistryReadOnly"
        ],
        "service_security_groups": {
          "internal": {
            "cidrs": [
              "vpc"
            ],
            "ports": [
              80,
              443
            ]
          },
          "public": {
            "cidrs": [
              "0.0.0.0/0"
            ],
            "ports": [
              80,
              443
            ]
          }
        }
      },
      "location": "us-east-1",
      "name_prefix": "ex-minimal",
      "network": {
        "availability_zones": [
          "us-east-1a",
          "us-east-1b"
        ],
        "flow_logs": false,
        "gateway_endpoints": [
          "s3",
          "dynamodb"
        ],
        "nat_gateway": "none",
        "subnets": {
          "public": {
            "cidrs": [
              "10.30.0.0/24",
              "10.30.1.0/24"
            ],
            "route": "internet"
          }
        },
        "vpc_cidr": "10.30.0.0/16"
      },
      "object_storage": {
        "versioning": true
      },
      "postgresql": {
        "allocated_storage_gb": 100,
        "backup_retention_days": 7,
        "deletion_protection": true,
        "engine_version": "16",
        "instance_class": "db.t4g.medium",
        "max_allocated_storage_gb": 500,
        "multi_az": false,
        "subnet_tier": "datastore"
      },
      "public_dns": {
        "delegated": false
      },
      "redis": {
        "engine_version": "7.1",
        "node_type": "cache.t4g.small",
        "num_cache_clusters": 1,
        "subnet_tier": "datastore"
      },
      "state": {
        "air_gapped": true,
        "backend": "local",
        "encryption": "AES256",
        "versioning": true
      },
      "upstream_state": {
        "core-network": {
          "backend": "local",
          "config": {
            "path": "/tmp/rtifact-golden-home/.rtifact/ex-minimal/state/core-network.tfstate"
          }
        },
        "data-platform": {
          "backend": "local",
          "config": {
            "path": "/tmp/rtifact-golden-home/.rtifact/ex-minimal/state/data-platform.tfstate"
          }
        }
      }
    }
  },
